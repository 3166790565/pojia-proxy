# 破甲路由中转站 · 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# ---- 管理员密码（明文）----
# 登录 WebUI 用的密码。不填则首次启动自动生成随机密码并打印到容器日志：
#   docker compose logs relay | grep -A1 初始密码
# 明文只在启动时读入并转成 scrypt 哈希存库，不会以明文落盘。
ADMIN_PASSWORD=change-me

# ---- 会话签名密钥 ----
# 用于签名登录 cookie。留空则首次启动自动生成并持久化到 /data/.secret_key，
# 重启后会话仍然有效。若要固定（例如多实例共享会话），填一个足够长的随机串：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- 可选：监听与端口 ----
# RELAY_BIND=127.0.0.1
# RELAY_PORT=8000

# ---- 可选：运行参数 ----
# REQUEST_TIMEOUT=300
# MAX_BODY_BYTES=4194304
# LOG_RETENTION_DAYS=7
